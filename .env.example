# Dune Chat Monitor example configuration.
# The installer writes the real local configuration to:
#   config/dune-chat-monitor.env
#
# No RabbitMQ credentials are required.
# Timestamps are stored in UTC and displayed in the browser's local timezone.

CHAT_RETENTION_DAYS="30"
CHAT_PAGE_SIZE="50"
CHAT_BOOTSTRAP_SINCE="1h"

TEXT_ROUTER_CONTAINER="dune-text-router"
