# Dune Chat Monitor example configuration.
# The installer writes the real private configuration to:
#   config/dune-chat-monitor.env

SERVER_NAME="Dune Server"
TIMEZONE="UTC"

CHAT_RETENTION_DAYS="30"
CHAT_EXPORT_LIMIT="250"

RMQ_QUEUE="dune.chat.monitor"
RMQ_USER="dune_chat_monitor"
RMQ_EXCHANGE="chat.intercept"
